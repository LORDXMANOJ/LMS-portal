<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/sidebar') %>
<div class="with-sidebar">
<main class="page">
  <div class="container">
    <h1>Your courses</h1>
    <p class="muted">Manage materials, assignments, and grading for the courses you teach.</p>

    <div class="grid">
      <% courses.forEach(c => { %>
        <a href="/faculty/courses/<%= c.id %>" class="card" style="display:block;color:inherit;">
          <h3><%= c.code %></h3>
          <p class="muted" style="font-size:0.88rem;"><%= c.title %></p>
          <p class="faint"><%= c.student_count %> students &middot; <%= c.assignment_count %> assignments</p>
        </a>
      <% }) %>
      <% if (courses.length === 0) { %>
        <div class="empty-state">No courses assigned yet. Ask an administrator to assign you to a course.</div>
      <% } %>
    </div>

    <div class="section-header">
      <h2>Upcoming due dates</h2>
      <a href="/faculty/submissions" class="faint">All submissions &rarr;</a>
    </div>
    <% if (upcomingDue.length === 0) { %>
      <div class="empty-state">No upcoming assignments.</div>
    <% } else { %>
      <ul class="list-plain">
        <% upcomingDue.forEach(a => { %>
          <% const urgency = urgencyClass(a.due_date, false); %>
          <li>
            <div class="card-title-row">
              <div>
                <a href="/faculty/assignments/<%= a.id %>"><strong><%= a.title %></strong></a>
                <div class="due-date <%= urgency %>"><%= a.course_code %> &middot; due <%= a.due_date %></div>
              </div>
              <span class="faint"><%= a.submission_count %> / <%= a.enrolled_count %> submitted</span>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <div class="section-header"><h2>Recent submissions</h2></div>
    <% if (recentSubmissions.length === 0) { %>
      <div class="empty-state">No submissions yet.</div>
    <% } else { %>
      <table>
        <thead><tr><th>Student</th><th>Assignment</th><th>Course</th><th>Submitted</th><th>Status</th></tr></thead>
        <tbody>
          <% recentSubmissions.forEach(s => { %>
            <tr>
              <td><%= s.student_name %></td>
              <td><%= s.assignment_title %></td>
              <td><%= s.course_code %></td>
              <td class="faint"><%= s.submitted_at %></td>
              <td>
                <% if (s.status === 'graded') { %><span class="badge badge-graded">Graded</span>
                <% } else if (s.status === 'late') { %><span class="badge badge-late">Late</span>
                <% } else { %><span class="badge badge-submitted">Submitted</span><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
</div>
<%- include('../partials/footer') %>
