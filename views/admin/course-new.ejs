<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/sidebar') %>
<div class="with-sidebar">
<main class="page">
  <div class="container" style="max-width:520px;">
    <a href="<%= deptId ? '/admin/departments/' + deptId : '/admin' %>" class="faint">&larr; Back</a>
    <h1>New course</h1>
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>
    <form method="POST" action="/admin/courses">
      <% if (deptId) { %><input type="hidden" name="dept_id" value="<%= deptId %>"><% } %>
      <div class="field-row">
        <div class="field"><label for="code">Course code</label><input type="text" id="code" name="code" placeholder="CS101" required></div>
        <div class="field"><label for="faculty_id">Faculty</label>
          <select id="faculty_id" name="faculty_id">
            <option value="">Unassigned</option>
            <% facultyList.forEach(f => { %><option value="<%= f.id %>"><%= f.name %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="field"><label for="title">Title</label><input type="text" id="title" name="title" required></div>
      <div class="field"><label for="description">Description</label><textarea id="description" name="description"></textarea></div>
      <button type="submit" class="btn btn-primary">Create course</button>
    </form>
  </div>
</main>
</div>
<%- include('../partials/footer') %>
