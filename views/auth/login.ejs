<%- include('../partials/head') %>
<main class="login-split">
  <div class="login-brand">
    <div class="login-brand-top">
      <span class="login-logo">Coursework</span>
      <span class="login-logo-tag">Learning Management</span>
    </div>

    <div class="login-brand-mid">
      <p class="login-kicker">Enrollment to outcome</p>
      <h1 class="login-headline">Every course.<br>Every student.<br>One clear<br>picture.</h1>
      <p class="login-sub">Connect course content, assignments and progress. Follow every student from their first enrollment to their final grade.</p>
    </div>

    <div class="login-brand-bottom">
      <span>01 / COURSES</span>
      <span>02 / ASSIGNMENTS</span>
      <span>03 / PROGRESS</span>
    </div>
  </div>

  <div class="login-form-panel">
    <div class="login-form-wrap">
      <p class="login-form-kicker">Your workspace</p>
      <h2 class="login-form-title">Welcome back</h2>
      <p class="login-form-sub">Sign in with the account provided by your institution.</p>

      <% if (error) { %>
        <div class="error-msg"><%= error %></div>
      <% } %>

      <form method="POST" action="/login" class="login-form">
        <div class="field">
          <label for="email">Email address</label>
          <input type="email" id="email" name="email" required autofocus>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%;">Sign in</button>
      </form>

      <p class="login-help">Forgot your password or need access? Contact your department head or administrator.</p>
    </div>
  </div>
</main>
</body>
</html>
